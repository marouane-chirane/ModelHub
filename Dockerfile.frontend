FROM node:20-alpine
WORKDIR /app

# Install deps with cache: copy only package manifests first
COPY frontend/package.json ./package.json
# If you later add a package-lock.json or pnpm-lock.yaml, copy it here too for better cache
RUN npm i --no-fund --no-audit

# Copy the rest of the app (keeps deps cache if sources change)
COPY frontend/ .

ENV VITE_API_URL="http://localhost:8000/api/v1"
EXPOSE 5173
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]

